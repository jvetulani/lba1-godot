[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_action_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://scenes/ui/Menu.tscn" id="2_menu"]

[node name="PauseMenu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_panel")

[node name="Center" parent="." instance=ExtResource("2_menu")]

[node name="Title" parent="Center/Panel/Contents" index="0"]
text = "Paused"

[node name="Primary" parent="Center/Panel/Contents" index="2"]
caption = "Continue"
metadata/action = "resume"

[node name="Continue" parent="Center/Panel/Contents" index="3"]
visible = false

[node name="Save" parent="Center/Panel/Contents" index="4"]
disabled = false

[node name="Exit" parent="Center/Panel/Contents" index="7"]
caption = "Quit to Menu"
metadata/action = "quit_to_main"

[node name="Settings" parent="Center/Panel/Contents" index="6"]
caption = "Options"
